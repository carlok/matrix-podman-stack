# --- Host persistence (bind mounts; survives compose down -v) ---
DATA_DIR=./data

# --- Matrix homeserver identity ---
# DNS A/AAAA for this name must point at your host (or split-horizon DNS).
SYNAPSE_SERVER_NAME=matrix.example.com

# Public URLs (what browsers / clients use via your nginx reverse proxy)
PUBLIC_HOMESERVER_URL=https://matrix.example.com
PUBLIC_ELEMENT_URL=https://chat.example.com

# Local bind ports (127.0.0.1 only — nginx on the host proxies here)
SYNAPSE_HTTP_PORT=8008
ELEMENT_HTTP_PORT=8080

# Rootless Podman: match volume ownership (defaults 1000:1000)
HOST_UID=1000
HOST_GID=1000

# --- Synapse Postgres ---
SYNAPSE_POSTGRES_USER=synapse
SYNAPSE_POSTGRES_PASSWORD=change_me_synapse_db
SYNAPSE_POSTGRES_DB=synapse

# --- Synapse secrets (generate with: openssl rand -hex 32) ---
REGISTRATION_SHARED_SECRET=change_me_registration_shared_secret
MATRIX_MACAROON_SECRET=change_me_macaroon_secret
MATRIX_FORM_SECRET=change_me_form_secret

# --- Bot provisioning (scripts/create-bots.sh) ---
# Primary config: bots.yaml (copy from bots.example.yaml). Optional overrides:
BOT_CONFIG=./bots.yaml
# Pattern-mode overrides (ignored when bots.yaml lists explicit `bots:`)
BOT_COUNT=
BOT_NAME_PREFIX=
BOT_TOKENS_FILE=./data/bots/tokens.env
# (default resolves under DATA_DIR if you use scripts/create-bots.sh)
SYNAPSE_INTERNAL_URL=http://127.0.0.1:8008

# --- Example bot / LLM stub ---
LLM_PROVIDER=stub
LLM_PROVIDER_KEY=

# --- Telegram bridge (profile: telegram) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_POSTGRES_USER=mautrix_telegram
TELEGRAM_POSTGRES_PASSWORD=change_me_telegram_db
TELEGRAM_POSTGRES_DB=mautrix_telegram

# --- Bot bus (profile: bus) — NATS JetStream + Valkey KV ---
NATS_USER=bots
NATS_PASSWORD=change_me_nats
NATS_URL=nats://bots:change_me_nats@nats:4222
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222
VALKEY_PASSWORD=change_me_valkey
VALKEY_HOST=valkey
VALKEY_PORT=16379
# Example bot: set BUS_DEMO=true and point at bus services when profile is enabled
BUS_DEMO=false

# --- Object storage (profile: object) — Garage S3-compatible ---
# Garage rpc_secret must be 32 random bytes as hex: openssl rand -hex 32
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=change_me_garage_admin
GARAGE_S3_REGION=garage
GARAGE_BUCKET=bot-artifacts
GARAGE_S3_PORT=13900
GARAGE_ADMIN_PORT=13903

# --- Vector store (profile: vectors) — Qdrant ---
QDRANT_API_KEY=change_me_qdrant
QDRANT_HTTP_PORT=16333

# --- Local LLM (profile: llm) — Ollama, keyless on localhost ---
OLLAMA_PORT=11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=tinyllama

# --- Monitoring (profile: monitoring) ---
PROMETHEUS_HTTP_PORT=9090
GRAFANA_HTTP_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# --- Optional container memory caps (compose mem_limit; unset = use compose default) ---
# POSTGRES_MEM_LIMIT=512m
# SYNAPSE_MEM_LIMIT=768m
# ELEMENT_MEM_LIMIT=128m
# NATS_MEM_LIMIT=256m
# VALKEY_MEM_LIMIT=256m
# GARAGE_MEM_LIMIT=512m
# QDRANT_MEM_LIMIT=1g
# OLLAMA_MEM_LIMIT=8g
# PROMETHEUS_MEM_LIMIT=512m
# GRAFANA_MEM_LIMIT=512m
# MAUTRIX_TELEGRAM_MEM_LIMIT=512m

# --- Admin (rate-limit overrides in create-bots.sh; smoke tests) ---
SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=
BOT_RATELIMIT_MPS=1000
BOT_RATELIMIT_BURST=1000

# --- Smoke test helpers (optional) ---
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=
