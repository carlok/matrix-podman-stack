# --- Matrix homeserver identity ---
# DNS A/AAAA for this name must point at your host (or split-horizon DNS).
SYNAPSE_SERVER_NAME=matrix.example.com

# Public URLs (what browsers / clients use via your nginx reverse proxy)
PUBLIC_HOMESERVER_URL=https://matrix.example.com
PUBLIC_ELEMENT_URL=https://chat.example.com

# Local bind ports (127.0.0.1 only — nginx on the host proxies here)
SYNAPSE_HTTP_PORT=8008
ELEMENT_HTTP_PORT=8080

# Rootless Podman: match volume ownership (defaults 1000:1000)
HOST_UID=1000
HOST_GID=1000

# --- Synapse Postgres ---
SYNAPSE_POSTGRES_USER=synapse
SYNAPSE_POSTGRES_PASSWORD=change_me_synapse_db
SYNAPSE_POSTGRES_DB=synapse

# --- Synapse secrets (generate with: openssl rand -hex 32) ---
REGISTRATION_SHARED_SECRET=change_me_registration_shared_secret
MATRIX_MACAROON_SECRET=change_me_macaroon_secret
MATRIX_FORM_SECRET=change_me_form_secret

# --- Bot provisioning (scripts/create-bots.sh) ---
# Primary config: bots.yaml (copy from bots.example.yaml). Optional overrides:
BOT_CONFIG=./bots.yaml
# Pattern-mode overrides (ignored when bots.yaml lists explicit `bots:`)
BOT_COUNT=
BOT_NAME_PREFIX=
BOT_TOKENS_FILE=./data/bots/tokens.env
SYNAPSE_INTERNAL_URL=http://127.0.0.1:8008

# --- Example bot / LLM stub ---
LLM_PROVIDER=stub
LLM_PROVIDER_KEY=

# --- Telegram bridge (profile: telegram) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_POSTGRES_USER=mautrix_telegram
TELEGRAM_POSTGRES_PASSWORD=change_me_telegram_db
TELEGRAM_POSTGRES_DB=mautrix_telegram

# --- Monitoring (profile: monitoring) ---
PROMETHEUS_HTTP_PORT=9090
GRAFANA_HTTP_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# --- Smoke test helpers (optional, not used in production) ---
TEST_ADMIN_USER=admin
TEST_ADMIN_PASSWORD=
